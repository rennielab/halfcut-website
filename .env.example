# Sanity project — created via `bun x sanity init` in the studio/ folder, or in sanity.io UI.
# Both vars are needed at BUILD time on Vercel and at dev time locally.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Optional: a token with read permissions if the dataset is private (it doesn't need to be).
# SANITY_READ_TOKEN=
