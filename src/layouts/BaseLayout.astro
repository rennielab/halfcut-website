---
/**
 * Base layout. Every page extends this — gets:
 *  - proper <head> with SEO/social meta
 *  - design system stylesheet
 *  - shared Nav, Menu, Footer
 *  - carbon badge wiring
 */
import '~/styles/fonts.css';
import '~/styles/system.css';

import Nav from '~/components/Nav.astro';
import Menu from '~/components/Menu.astro';
import Footer from '~/components/Footer.astro';

interface Props {
  title: string;
  description: string;
  current?: string; // route slug, e.g. 'about' — used by Nav for active state
  ogImage?: string;
  dark?: boolean;   // toggles dark nav-on-photo state
  noindex?: boolean;
}

const {
  title,
  description,
  current,
  ogImage = '/og/halfcut-default.jpg',
  dark = false,
  noindex = false,
} = Astro.props;

const fullTitle = title === 'HalfCut' ? title : `${title} · HalfCut`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
  <meta property="og:site_name" content="HalfCut" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

  <!-- Favicons: HalfCut H mark, cropped from the corporate TM logo -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
  <link rel="apple-touch-icon" href="/favicon-512.png" />

  <!-- Theme -->
  <meta name="theme-color" content="#13140E" />
</head>
<body class={dark ? 'is-dark-page' : ''}>
  <Nav current={current} />
  <Menu />
  <main id="main">
    <slot />
  </main>
  <Footer />

  <script>
    /* Shared client behaviours (ported from legacy shell.js):
       - revealObserver: adds .in to .reveal / .reveal-children when scrolled into view
       - parallax: translates [data-parallax] based on scroll position
       - adaptiveNav: toggles .is-dark on .nav when the band behind it is a dark section
    */
    function revealObserver() {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.01 }
      );
      document.querySelectorAll('.reveal, .reveal-children').forEach((el) => io.observe(el));
    }

    function parallax() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const els = Array.from(document.querySelectorAll('[data-parallax]'));
      if (!els.length) return;
      const items = els.map((el) => ({
        el: el as HTMLElement,
        speed: parseFloat((el as HTMLElement).dataset.parallax || '0.12') || 0.12,
      }));
      let raf = 0;
      function update() {
        raf = 0;
        const vh = window.innerHeight;
        for (const { el, speed } of items) {
          const r = el.getBoundingClientRect();
          if (r.bottom < -vh || r.top > vh * 2) continue;
          const centre = r.top + r.height / 2;
          const offset = (centre - vh / 2) * speed;
          el.style.transform = `translate3d(0, ${(-offset).toFixed(1)}px, 0)`;
        }
      }
      function onScroll() { if (!raf) raf = requestAnimationFrame(update); }
      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
    }

    function adaptiveNav() {
      const nav = document.querySelector('.nav') as HTMLElement | null;
      if (!nav) return;
      const DARK = '.hero,.pillar,.geomap,.cta-band,.campaign,.on-ink,.on-country,.dollar,.cinematic,.ambient,.ambient-quote,.dark,.ink-section,.site-footer';
      function update() {
        const x = window.innerWidth / 2;
        const y = 28;
        const els = document.elementsFromPoint(x, y);
        let dark = false;
        for (const el of els) {
          if (el === nav || nav.contains(el)) continue;
          if ((el as HTMLElement).matches?.(DARK) || (el as HTMLElement).closest?.(DARK)) {
            dark = true;
            break;
          }
        }
        nav.classList.toggle('is-dark', dark);
      }
      let raf = 0;
      function onScroll() { if (!raf) raf = requestAnimationFrame(() => { raf = 0; update(); }); }
      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
    }

    function init() {
      revealObserver();
      parallax();
      adaptiveNav();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  </script>
</body>
</html>

<style is:global>
  html, body { margin: 0; padding: 0; background: var(--cream); color: var(--ink); }
  body { font-family: var(--f-serif); }
  *, *::before, *::after { box-sizing: border-box; }
  img, video { display: block; max-width: 100%; height: auto; }
  a { color: inherit; }
  main { display: block; }
  /* dark={true} only sets the FALLBACK page background to ink so the browser
     'overscroll' area matches. It does NOT invert the default text colour —
     every section owns its own colour, so light-bg sections keep ink text
     and dark-bg sections set cream themselves. Prevents cream-on-cream bleed. */
  .is-dark-page { background: var(--ink); }
  :focus-visible { outline: 2px solid var(--acid); outline-offset: 3px; }
</style>
