---
import BaseLayout from '~/layouts/BaseLayout.astro';

const projects = [
  {
    slug: 'go-halfcut',
    tag: 'August · Fundraise',
    title: 'Go HalfCut',
    body: 'Every August, thousands of Australians shave, cut or wear half something to raise funds for nature. No rules. Meet nature halfway, your way.',
    href: 'https://go.halfcut.org/',
    external: true,
    image: '/photos/photo_078.webp',
  },
  {
    slug: 'donate',
    tag: 'Give · Anytime',
    title: 'Donate to Nature for Life',
    body: 'Tax-deductible one-off, monthly or bequest gifts. 100% of profits to Country, through Jabalbina Yalanji Aboriginal Corporation.',
    href: '/donate',
    image: '/photos/photo_034.webp',
  },
  {
    slug: 'heal-country',
    tag: 'National Initiative',
    title: 'Heal Country. Heal Culture.',
    body: "HalfCut's national initiative connecting First Nations communities with funding, partnerships and public support to lead the restoration of Country.",
    href: '/heal-country',
    image: '/photos/hero-jabalbina-women.webp',
  },
  {
    slug: 'canopy',
    tag: 'Business Membership',
    title: 'The HalfCut Canopy',
    body: 'A living network of businesses restoring nature together. Bronze to Platinum tiers, monthly or annual, supporting the four pillars of impact.',
    href: '/canopy',
    image: '/photos/photo_055.webp',
  },
  {
    slug: 'yalada-tours',
    tag: 'On Country',
    title: 'Yalada Tours',
    body: 'Walk Country. Heal Country. Protect Country. Immersive on-Country experiences in the Daintree, guided by First Nations knowledge holders.',
    href: '/yalada-tours',
    image: '/photos/photo_022.webp',
  },
  {
    slug: 'legacy',
    tag: 'Leave a Legacy',
    title: 'Leave a Gift in Your Will',
    body: 'A bequest is a powerful way to keep protecting forests and supporting First Nations-led restoration beyond your lifetime.',
    href: '/donate#legacy',
    image: '/photos/photo_003.webp',
  },
  {
    slug: 'partner',
    tag: 'Organisations',
    title: 'Partner With Us',
    body: 'Values-aligned businesses, philanthropists and government partners. Assessed against the same framework Traditional Owner partners assess us against.',
    href: '/contact',
    image: '/photos/photo_099.webp',
  },
  {
    slug: 'reports',
    tag: 'Transparency',
    title: 'Read the Annual Reports',
    body: 'Every year we publish a full account of programs, finances and on-Country outcomes. Nothing behind a login.',
    href: '/annual-reports',
    image: '/photos/photo_071.webp',
  },
];
---

<BaseLayout
  title="Take Action"
  description="Every way to back HalfCut's mission to Protect and Restore Forever. Fundraise, donate, join the Canopy, visit Country, leave a legacy, or become a partner."
  current="take-action"
  dark={true}
>
  <section class="ta-hero">
    <div class="ta-hero-inner">
      <h1>The work<br />needs you.</h1>
      <p class="lede">
        Eight ways to back rainforest restoration and First Nations-led
        conservation. Pick the one that fits your life. Pick more than one
        if you have it in you.
      </p>
    </div>
  </section>

  <section class="ta-grid-wrap">
    <ul class="ta-grid">
      {projects.map((p) => (
        <li>
          <a class="ta-card" href={p.href}>
            <div class="ta-card-img" style={`background-image: url('${p.image}');`} aria-hidden="true"></div>
            <span class="pill">{p.tag}</span>
            <div class="body">
              <h2>{p.title}</h2>
              <p>{p.body}</p>
              <span class="arrow" aria-hidden="true">→</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .ta-hero {
    padding: var(--hero-pad-top) var(--pad-x) var(--pad-section-sm);
    background: var(--ink);
    color: var(--cream);
  }
  .ta-hero-inner { max-width: 1440px; margin: 0 auto; }
  .ta-hero h1 {
    font-family: var(--f-display);
    font-size: clamp(64px, 9vw, 180px);
    line-height: .88; letter-spacing: -0.025em;
    text-transform: uppercase;
    margin: 0;
    max-width: 14ch;
  }
  .ta-hero .lede {
    font-family: var(--f-serif); font-weight: 300;
    font-size: clamp(20px, 1.7vw, 26px);
    line-height: 1.4;
    margin-top: var(--s-6);
    max-width: 56ch;
    opacity: .85;
  }

  .ta-grid-wrap {
    background: var(--ink);
    padding: var(--s-8) var(--pad-x) var(--s-11);
  }
  .ta-grid {
    max-width: 1440px; margin: 0 auto;
    list-style: none; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-5);
  }
  .ta-grid > li { list-style: none; }
  .ta-card {
    position: relative; display: flex; flex-direction: column;
    aspect-ratio: 4 / 5;
    background: rgba(245,244,236,.04);
    border-radius: 6px;
    padding: var(--s-6);
    color: var(--cream);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition: transform .35s var(--ease, ease);
  }
  .ta-card:hover { transform: translateY(-4px); }
  .ta-card-img {
    position: absolute; inset: 0; z-index: 0;
    background-size: cover; background-position: center;
    filter: brightness(.5) saturate(.9);
    transition: transform .9s var(--ease, ease), filter .35s var(--ease, ease);
  }
  .ta-card:hover .ta-card-img { transform: scale(1.04); filter: brightness(.6) saturate(1); }
  .ta-card::after {
    content: ''; position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(180deg, rgba(19,20,14,.15) 0%, rgba(19,20,14,.15) 40%, rgba(19,20,14,.92) 100%);
  }
  .pill {
    position: relative; z-index: 2;
    display: inline-flex; width: fit-content;
    padding: 7px 13px;
    border-radius: 999px;
    background: rgba(19,20,14,.55);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    font-family: var(--f-sans);
    font-size: 10px; font-weight: 700;
    letter-spacing: .18em; text-transform: uppercase;
    color: var(--acid);
  }
  .body { position: relative; z-index: 2; margin-top: auto; }
  .ta-card h2 {
    font-family: var(--f-display);
    font-size: clamp(22px, 2.2vw, 32px);
    line-height: .95; letter-spacing: -0.015em; text-transform: uppercase;
    margin: 0 0 var(--s-3);
  }
  .ta-card p {
    font-family: var(--f-serif); font-weight: 300;
    font-size: 14px; line-height: 1.5;
    margin: 0 0 var(--s-4);
    opacity: .85;
  }
  .arrow {
    font-family: var(--f-sans); font-weight: 700;
    font-size: 20px;
    color: var(--acid);
    display: inline-block;
    transition: transform .25s ease;
  }
  .ta-card:hover .arrow { transform: translateX(4px); }

  @media (max-width: 1200px) { .ta-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 900px)  { .ta-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px)  { .ta-grid { grid-template-columns: 1fr; } .ta-card { aspect-ratio: 4/3; } }
</style>
