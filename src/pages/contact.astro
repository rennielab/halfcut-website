---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
---

<BaseLayout
  title="Contact"
  description="How to reach HalfCut. Partnerships, media, careers and general."
  current="contact"
>
  <PageHero
    eyebrow="Contact"
    title={'Tell us who\nyou are.'}
    lede="Route yourself below and you'll hear from a real person inside three working days. Vague messages go to the bottom of the pile."
  />

  <section class="contact-band">
    <form
      class="contact-form"
      action="https://formspree.io/f/PLACEHOLDER"
      method="POST"
    >
      <label class="grid2">
        <div class="field">
          <span class="label">Your name</span>
          <input type="text" name="name" required autocomplete="name" />
        </div>
        <div class="field">
          <span class="label">Email</span>
          <input type="email" name="email" required autocomplete="email" />
        </div>
      </label>
      <div class="field">
        <span class="label">I'm getting in touch about</span>
        <select name="topic" required>
          <option value="">Choose one</option>
          <option value="partnership">Partnership</option>
          <option value="media">Media / interview</option>
          <option value="careers">Careers</option>
          <option value="general">Something else</option>
        </select>
      </div>
      <div class="field">
        <span class="label">Message</span>
        <textarea name="message" rows="6" required></textarea>
      </div>
      <button class="btn btn-primary" type="submit">Send →</button>
    </form>

    <aside class="contact-meta">
      <div>
        <span class="meta-label">Studio</span>
        <p>Gadigal Country<br />Sydney, NSW</p>
      </div>
      <div>
        <span class="meta-label">On Country</span>
        <p>Kuku Yalanji Country<br />By invitation only</p>
      </div>
      <div>
        <span class="meta-label">Follow</span>
        <p>Instagram · LinkedIn · Newsletter</p>
      </div>
    </aside>
  </section>
</BaseLayout>

<style>
  .contact-band {
    max-width: 1100px; margin: 0 auto;
    padding: var(--s-9, 96px) var(--pad-x, 32px);
    display: grid; grid-template-columns: 2fr 1fr; gap: var(--s-8, 64px);
  }
  .contact-form { display: flex; flex-direction: column; gap: var(--s-5, 24px); }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4, 16px); }
  .field { display: flex; flex-direction: column; gap: 8px; }
  .label {
    font-family: var(--f-sans); font-size: 11px; font-weight: 700;
    letter-spacing: .18em; text-transform: uppercase; opacity: .55;
  }
  input, select, textarea {
    width: 100%;
    border: 0; border-bottom: 1px solid var(--ink-15);
    background: transparent;
    padding: 12px 0;
    font-family: var(--f-serif); font-size: 18px; color: var(--ink);
    outline: none;
  }
  input:focus, select:focus, textarea:focus { border-color: var(--ink); }
  .contact-meta {
    display: flex; flex-direction: column; gap: var(--s-6, 32px);
    border-top: 1px solid var(--ink-15);
    padding-top: var(--s-6, 32px);
    font-family: var(--f-serif); font-weight: 300; font-size: 17px;
  }
  .meta-label {
    display: block;
    font-family: var(--f-sans); font-size: 11px; font-weight: 700;
    letter-spacing: .18em; text-transform: uppercase; opacity: .5;
    margin-bottom: 12px;
  }
  @media (max-width: 720px) {
    .contact-band { grid-template-columns: 1fr; }
    .grid2 { grid-template-columns: 1fr; }
  }
</style>
