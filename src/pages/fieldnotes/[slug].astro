---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getFieldNotes, getFieldNoteBySlug, urlFor } from '~/lib/sanity';

export async function getStaticPaths() {
  let notes: any[] = [];
  try { notes = await getFieldNotes(); } catch {}
  return notes.map((n: any) => ({ params: { slug: n.slug.current } }));
}

const { slug } = Astro.params;
let note: any = null;
try { note = await getFieldNoteBySlug(slug!); } catch {}
if (!note) return Astro.redirect('/fieldnotes');

const cover = note.cover?.asset ? urlFor(note.cover).width(2000).quality(80).url() : null;
const fmt = (d: string) => new Date(d).toLocaleDateString('en-AU', { day: '2-digit', month: 'long', year: 'numeric' });
---

<BaseLayout
  title={note.title}
  description={note.excerpt}
  ogImage={cover ?? undefined}
  dark={true}
>
  <article class="fn-article">
    <header class="fn-hero">
      {cover && <div class="fn-hero-bg" style={`background-image: url('${cover}');`} aria-hidden="true" data-parallax="0.15"></div>}
      <div class="fn-hero-inner">
        <span class="cat">{note.category}</span>
        <h1>{note.title}</h1>
        <p class="lede">{note.excerpt}</p>
        <div class="meta">
          {note.author?.name && <span>By {note.author.name}{note.author.role ? `, ${note.author.role}` : ''}</span>}
          <span>{fmt(note.publishedAt)}</span>
        </div>
      </div>
    </header>

    <div class="fn-body">
      {/* TODO: render Portable Text via @portabletext/to-html once authors begin publishing.
          Until then the body field is empty for new notes so nothing renders here. */}
    </div>
  </article>
</BaseLayout>

<style>
  .fn-article { background: var(--ink); color: var(--cream); }
  .fn-hero { position: relative; min-height: 80vh; overflow: hidden; }
  .fn-hero-bg {
    position: absolute; inset: -10% 0;
    background-size: cover; background-position: center;
    filter: brightness(.55) saturate(.9);
  }
  .fn-hero::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(19,20,14,.2) 0%, rgba(19,20,14,.8) 100%);
  }
  .fn-hero-inner {
    position: relative; z-index: 2;
    max-width: 880px; margin: 0 auto;
    padding: calc(var(--hero-pad-top, 160px) + 24px) var(--pad-x, 32px) var(--s-10, 128px);
  }
  .cat {
    display: inline-block;
    font-family: var(--f-sans); font-size: 11px; font-weight: 700;
    letter-spacing: .22em; text-transform: uppercase;
    padding: 7px 13px;
    border: 1px solid var(--cream-15);
    border-radius: 999px;
    color: var(--acid);
    background: rgba(19,20,14,.5);
    backdrop-filter: blur(8px);
    margin-bottom: var(--s-6, 32px);
  }
  .fn-hero h1 {
    font-family: var(--f-display);
    font-size: clamp(40px, 6vw, 88px);
    line-height: .95; letter-spacing: -0.025em; text-transform: uppercase;
    margin: 0 0 var(--s-6, 32px); text-wrap: balance;
  }
  .fn-hero .lede {
    font-family: var(--f-serif); font-weight: 300;
    font-size: clamp(18px, 1.5vw, 22px);
    line-height: 1.45;
    margin: 0 0 var(--s-7, 48px);
    max-width: 56ch; opacity: .9;
  }
  .meta {
    display: flex; gap: var(--s-5, 24px); flex-wrap: wrap;
    font-family: var(--f-sans); font-size: 11px;
    letter-spacing: .18em; text-transform: uppercase; opacity: .6;
  }
  .fn-body {
    max-width: 720px; margin: 0 auto;
    padding: var(--s-9, 96px) var(--pad-x, 32px) var(--s-10, 128px);
    font-family: var(--f-serif); font-weight: 300;
    font-size: 19px; line-height: 1.7;
  }
</style>
