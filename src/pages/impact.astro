<style is:global>
.imp-hero {
    padding: var(--hero-pad-top) var(--pad-x) var(--hero-pad-bottom);
    background: var(--ink);
    color: var(--cream);
    position: relative;
    overflow: hidden;
  }
  .imp-hero-inner { max-width: 1440px; margin: 0 auto; position: relative; z-index: 1; }
  .imp-hero .eyebrow { color: var(--acid); margin-bottom: var(--s-6); display: block; }
  .imp-hero h1 {
    font-family: var(--f-display);
    font-size: clamp(64px, 9vw, 180px);
    line-height: .88;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    max-width: 16ch;
  }
  .imp-hero-bottom {
    margin-top: var(--s-9);
    display: grid; grid-template-columns: 2fr 1fr; gap: var(--s-8); align-items: end;
    padding-top: var(--s-6); border-top: 1px solid var(--cream-15);
  }
  .imp-hero-bottom .lede { max-width: 46ch; opacity: .85; color: var(--cream); }
  .imp-hero-bottom .meta { font-family: var(--f-sans); font-size: 12px; letter-spacing: .12em; opacity: .5; }

  /* Big number band */
  .big-num {
    background: var(--acid);
    padding: var(--s-11) var(--pad-x);
    text-align: center;
    border-bottom: 1px solid var(--ink);
  }
  .big-num .label { font-family: var(--f-sans); font-weight: 700; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; margin-bottom: var(--s-5); }
  .big-num .stat {
    font-family: var(--f-display);
    font-size: clamp(120px, 22vw, 400px);
    line-height: .85;
    letter-spacing: -0.04em;
    display: block;
  }
  .big-num .stat .unit {
    font-family: var(--f-serif);  font-weight: 300;
    font-size: 0.28em; letter-spacing: 0;
    margin-left: 12px; vertical-align: baseline;
    opacity: .7;
  }
  .big-num p {
    max-width: 52ch; margin: var(--s-5) auto 0;
    font-family: var(--f-serif); font-weight: 300; font-size: 22px;
    line-height: 1.45;
  }

  /* Ledger table */
  .ledger {
    padding: var(--s-10) var(--pad-x);
    background: var(--cream);
  }
  .ledger-head {
    max-width: 1440px; margin: 0 auto var(--s-7);
    display: flex; justify-content: space-between; align-items: flex-end;
  }
  .ledger-head h2 { font-family: var(--f-display); font-size: clamp(56px, 7vw, 120px); line-height: .9; letter-spacing: -0.02em; text-transform: uppercase; }
  .ledger-table {
    max-width: 1440px; margin: 0 auto;
    border-top: 2px solid var(--ink);
  }
  .ledger-row {
    display: grid;
    grid-template-columns: 80px 2fr 1fr 1fr 1fr 1fr;
    gap: var(--s-5);
    padding: 22px 0;
    border-bottom: 1px solid var(--ink-15);
    align-items: baseline;
    font-family: var(--f-sans);
    transition: background .2s;
  }
  .ledger-row:hover { background: var(--stone); padding-left: 8px; padding-right: 8px; }
  .ledger-row.header { font-weight: 700; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; opacity: .55; padding-bottom: 16px; padding-top: 16px; }
  .ledger-row .year { font-family: var(--f-display); font-size: 22px; letter-spacing: -0.01em; }
  .ledger-row .partner { font-family: var(--f-serif); font-size: 19px; font-weight: 400; }
  .ledger-row .num { font-family: var(--f-display); font-size: 24px; letter-spacing: -0.01em; }

  /* Year breakdown: how every dollar lands */
  .dollar {
    background: var(--ink); color: var(--cream);
    padding: var(--s-11) var(--pad-x);
    position: relative; overflow: hidden;
  }
  .dollar-topo {
    position: absolute; inset: 0;
    background-image: url('/assets-legacy/topo-pattern.png');
    background-repeat: repeat;
    background-size: 1100px auto;
    opacity: .08;
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .dollar-inner {
    max-width: 1600px; margin: 0 auto; position: relative;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
