          <div class="donut-big"><span data-count="92" data-suffix="¢">0¢</span></div>
          <div class="donut-cap">of every dollar<br>reaches Country</div>
        </div>
      </div>

      <ul class="dollar-legend">
        <li>
          <span class="ll-tick to-country"></span>
          <div>
            <div class="ll-pct"><span data-count="92" data-suffix="¢">0¢</span></div>
            <div class="ll-lbl">To Country</div>
            <div class="ll-desc">Direct, unrestricted transfer to Traditional Owner corporations for ranger wages, seedlings, equipment, on-Country costs.</div>
          </div>
        </li>
        <li>
          <span class="ll-tick programs"></span>
          <div>
            <div class="ll-pct"><span data-count="5" data-suffix="¢">0¢</span></div>
            <div class="ll-lbl">Program &amp; campaign delivery</div>
            <div class="ll-desc">Field coordination, campaign production, partner reporting, donor communications.</div>
          </div>
        </li>
        <li>
          <span class="ll-tick ops"></span>
          <div>
            <div class="ll-pct"><span data-count="3" data-suffix="¢">0¢</span></div>
            <div class="ll-lbl">Operations &amp; compliance</div>
            <div class="ll-desc">Insurance, audit, governance, legal, platform. Held under 5% by policy.</div>
          </div>
        </li>
      </ul>
