<script>
// H-emerge fallback for browsers without scroll-driven animations (Safari/Firefox)
(function(){
  if (CSS.supports('animation-timeline: view()')) return;
  const els = document.querySelectorAll('.cinematic.h-emerge img');
  if (!els.length) return;
  function update() {
    const vh = window.innerHeight;
    els.forEach(img => {
      const sec = img.closest('.cinematic');
      const r = sec.getBoundingClientRect();
      // progress: 0 when section top hits viewport bottom, 1 at ~55% through
      const total = r.height + vh;
      const traveled = vh - r.top;
      let p = traveled / (total * 0.55);
      p = Math.max(0, Math.min(1, p));
      img.style.setProperty('--p', p.toFixed(3));
    });
  }
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  update();
})();

// Dollar section: animate donut segments + counters on scroll-in
(function () {
  const section = document.querySelector('.dollar');
  if (!section) return;
  const donut = section.querySelector('.donut');
  const counters = section.querySelectorAll('[data-count]');
  donut.classList.add('loading');

  let played = false;

  function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }

  function animateCounters(duration) {
    const start = performance.now();
    function step(now) {
      const t = Math.min(1, (now - start) / duration);
      const e = easeOutCubic(t);
      counters.forEach(el => {
        const target = parseFloat(el.dataset.count);
        const prefix = el.dataset.prefix || '';
        const suffix = el.dataset.suffix || '';
        let v = target * e;
        if (target >= 1000) {
          el.textContent = prefix + Math.round(v).toLocaleString() + suffix;
        } else {
          el.textContent = prefix + Math.round(v) + suffix;
        }
      });
      if (t < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  function play() {
    if (played) return;
    played = true;
    // Donut: segments are in markup with final stroke-dasharray values,
    // but .loading class overrides them to 0. Remove it with a tiny delay to trigger CSS transition.
    requestAnimationFrame(() => {
      donut.classList.remove('loading');
    });
    animateCounters(1800);
  }

  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) play(); });
  }, { threshold: 0.35 });
  io.observe(section);
})();
</script>
