---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import Placeholder from '~/components/Placeholder.astro';
import { getImpactMetrics } from '~/lib/sanity';

let metrics: any[] = [];
try { metrics = await getImpactMetrics(); } catch {}
---

<BaseLayout
  title="Impact"
  description="Public-record numbers HalfCut and its partners publish. Every figure on this page has a citation."
  current="impact"
>
  <PageHero
    eyebrow="Impact · sourced figures only"
    title={'No soft\naccounting.'}
    lede="Every number on this page is cited. If the source isn't on the public record, the number isn't on this page."
  />

  {metrics.length === 0 ? (
    <Placeholder
      what="The full impact ledger"
      fromWho="HalfCut's annual report + Jabalbina + ACNC. Every row must have a source URL."
    />
  ) : (
    <section class="impact-ledger">
      <ol class="ledger">
        {metrics.map((m: any) => (
          <li class="ledger-row">
            <div class="ledger-num">
              <span class="value">{m.value}</span>
              {m.unit && <span class="unit">{m.unit}</span>}
            </div>
            <div class="ledger-body">
              <span class="label">{m.label}</span>
              {m.note && <p class="note">{m.note}</p>}
              <a class="src" href={m.sourceUrl} target="_blank" rel="noopener">
                Source: {m.source} ↗
              </a>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}
</BaseLayout>

<style>
  .impact-ledger {
    max-width: 1100px; margin: 0 auto;
    padding: var(--s-9, 96px) var(--pad-x, 32px);
  }
  .ledger { list-style: none; margin: 0; padding: 0; }
  .ledger-row {
    display: grid; grid-template-columns: 1fr 2fr;
    gap: var(--s-7, 48px);
    padding: var(--s-7, 48px) 0;
    border-top: 1px solid var(--ink-15);
  }
  .ledger-row:last-child { border-bottom: 1px solid var(--ink-15); }
  .ledger-num { display: flex; align-items: baseline; gap: 8px; }
  .ledger-num .value {
    font-family: var(--f-display);
    font-size: clamp(56px, 8vw, 140px);
    line-height: .85; letter-spacing: -0.025em;
  }
  .ledger-num .unit {
    font-family: var(--f-sans); font-size: 12px;
    letter-spacing: .14em; text-transform: uppercase; opacity: .55;
  }
  .label {
    display: block;
    font-family: var(--f-sans); font-size: 11px;
    letter-spacing: .18em; text-transform: uppercase; font-weight: 700;
    opacity: .55; margin-bottom: var(--s-3, 12px);
  }
  .note {
    font-family: var(--f-serif); font-weight: 300;
    font-size: 18px; line-height: 1.5; margin: 0 0 var(--s-4, 16px);
  }
  .src {
    font-family: var(--f-sans); font-size: 11px;
    letter-spacing: .14em; text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: var(--coral);
    text-underline-offset: 4px;
  }
</style>
