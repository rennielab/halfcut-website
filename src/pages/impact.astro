  .dollar .eyebrow { color: var(--acid); display: block; margin-bottom: var(--s-5); }
  .dollar p {
    font-family: var(--f-serif); font-weight: 300;
    font-size: 20px; line-height: 1.5;
    margin-top: var(--s-6); opacity: .82; max-width: 46ch;
  }
