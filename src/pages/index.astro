<!-- =================== CTA BAND =================== -->
<section class="cta-band" data-screen-label="01 Home · CTA">
  <div class="topo-bg" style="opacity:.15; mix-blend-mode:multiply;"></div>
  <h2 class="reveal">Resource<br>the work.</h2>
  <p class="reveal">
    Every contribution flows through governance developed with Traditional Owners. This isn't charity, it's investment in the people who have been restoring this Country for 60,000 years.
  </p>
  <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
    <a href="/donate" class="btn btn-primary">Donate now →</a>
    <a href="/contact" class="btn btn-secondary" style="border-color: var(--ink);">Partner with us</a>
  </div>
</section>


<script>
  // Bridge section, subtle parallax on image + copy block
  (function bridgeParallax() {
    const section = document.querySelector('.bridge');
    const img = document.getElementById('bridgeImg');
    const copy = document.querySelector('.bridge-copy');
    const num = document.querySelector('.bridge-bignum');
    if (!section || !img) return;
    let raf = 0;
    function update() {
      raf = 0;
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight;
      // progress 0 when section enters from bottom, 1 when it leaves from top
      const total = rect.height + vh;
      const progress = Math.max(0, Math.min(1, (vh - rect.top) / total));
      // -1..1 centered
      const p = (progress - 0.5) * 2;
      img.style.transform = `translate3d(0, ${(-p * 8).toFixed(2)}%, 0) scale(1.08)`;
      if (num) num.style.transform = `translate3d(0, ${(-p * 40).toFixed(1)}px, 0)`;
    }
    function onScroll() { if (!raf) raf = requestAnimationFrame(update); }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  })();

  // Live forest-loss tracker
  // Baselines (rounded, public-domain stats): Global Forest Watch reports
  // ~10 million hectares of tree cover lost per year (~27,400 ha/day).
  // Avg stand density used: ~470 trees/ha (conservative tropical+boreal blend).
  // So ~ 27,400 * 470 / 86,400 ≈ 149 trees/sec globally.
  (function tracker() {
    const trees = document.getElementById('trk-trees');
    const ha = document.getElementById('trk-ha');
    if (!trees || !ha) return;

    // Floating ticker (appears after hero) — click opens Truth drawer
    const floatTicker = document.createElement('button');
    floatTicker.className = 'trees-ticker';
    floatTicker.type = 'button';
    floatTicker.setAttribute('aria-label', 'Open deforestation truth drawer');
    floatTicker.innerHTML = `
      <span class="dot" aria-hidden="true"></span>
      <span class="label">Trees lost since you arrived</span>
      <span class="count" id="trk-trees-float">0</span>
      <span class="more" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 6l6 6-6 6"/></svg>
      </span>
    `;
    document.body.appendChild(floatTicker);
    const treesFloat = document.getElementById('trk-trees-float');
    floatTicker.addEventListener('click', () => {
      const panel = document.getElementById('truthPanel');
      if (panel) {
        panel.classList.add('open');
        panel.setAttribute('aria-hidden', 'false');
        document.documentElement.style.overflow = 'hidden';
      }
    });

    const TREES_PER_SEC = 149;
    const HA_PER_SEC = 27400 / 86400;       // ~0.317 ha/sec
    const startOfDay = new Date(); startOfDay.setHours(0,0,0,0);
    const secsSinceMidnight = (Date.now() - startOfDay.getTime()) / 1000;

    // Baseline cover %: FAO ~31.0% of land. Drift slowly (cosmetic, ~0.01%/year)
    const baseCover = 31.000;
    const hectaresLostThisYear = (Date.now() - new Date(new Date().getFullYear(),0,0).getTime()) / 1000 * HA_PER_SEC;
    const coverNow = baseCover - (hectaresLostThisYear / 4_060_000_000 * 100); // 4.06 Bha total forest

    // Starting values
    let treesSinceLoad = 0;
    let haToday = secsSinceMidnight * HA_PER_SEC;

    function fmt(n, dp=0) {
      return n.toLocaleString('en-AU', { minimumFractionDigits: dp, maximumFractionDigits: dp });
    }
    function paint() {
      trees.innerHTML = fmt(Math.floor(treesSinceLoad));
      if (treesFloat) treesFloat.innerHTML = fmt(Math.floor(treesSinceLoad));
      ha.innerHTML = fmt(Math.floor(haToday)) + '<span class="u">ha</span>';
    }
    paint();

    // Show floating ticker once the hero tracker has scrolled out of view
    const heroTracker = document.querySelector('.hero-tracker');
    window.addEventListener('scroll', () => {
      if (!heroTracker) return;
      const rect = heroTracker.getBoundingClientRect();
      if (rect.bottom < 40) floatTicker.classList.add('show');
      else floatTicker.classList.remove('show');
    }, { passive: true });

    // Smooth ticking (10Hz)
    const tickMs = 100;
    setInterval(() => {
      treesSinceLoad += TREES_PER_SEC * (tickMs/1000);
      haToday += HA_PER_SEC * (tickMs/1000);
      paint();
      // pulse the values subtly
      trees.classList.remove('tick'); void trees.offsetWidth; trees.classList.add('tick');
    }, tickMs);
  })();

  // Hero parallax
  const heroBg = document.getElementById('heroBg');
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (y < window.innerHeight) {
      heroBg.style.transform = `scale(1.05) translateY(${y * 0.3}px)`;
    }
  }, { passive: true });

  // Geomap horizontal scroll-jack
  // Truth drawer: open/close behaviour
  // Use delegated listeners on document because the script block runs
  // BEFORE the .truth-panel markup is parsed at the bottom of body.
  (function truthDrawer() {
    function close() {
      const panel = document.getElementById('truthPanel');
      if (!panel) return;
      panel.classList.remove('open');
      panel.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
    }
    document.addEventListener('click', (e) => {
      // Any [data-close] inside #truthPanel closes the panel
      const target = e.target.closest && e.target.closest('[data-close]');
      if (target && target.closest('#truthPanel')) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const panel = document.getElementById('truthPanel');
      if (panel && panel.classList.contains('open')) close();
    });
  })();
</script>

<!-- ============== TRUTH DRAWER (deforestation source-of-truth) ============== -->
<div class="truth-panel" id="truthPanel" aria-hidden="true">
  <div class="truth-panel-scrim" data-close></div>
  <aside class="truth-panel-card" role="dialog" aria-modal="true" aria-labelledby="truthPanelTitle">
    <header class="truth-head">
      <span class="label">Live · The truth about forests</span>
      <button class="truth-close" data-close aria-label="Close truth drawer">Close <span aria-hidden="true">✕</span></button>
    </header>

    <div class="truth-body">
      <span class="truth-eyebrow">Source of truth</span>
      <h2 class="truth-h1" id="truthPanelTitle">Half the world's<br>forests are gone.</h2>
      <p class="truth-lede">
        Not a slogan. A documented fact. The numbers below are drawn from public data, audited research, and the ground itself. They're why HalfCut exists.
      </p>

      <div class="truth-section">
        <span class="truth-section-label">Global · what's left</span>
        <div class="truth-stat">
          <div class="big">&lt; 3%</div>
          <div class="lbl">of the world's original rainforest still standing. The rest is gone, fragmented, or in the queue to be cleared.<span class="src">Source: HalfCut Organisation · halfcut.org/impact</span></div>
        </div>
        <div class="truth-stat">
          <div class="big">10 M ha</div>
          <div class="lbl">of forest lost worldwide every year, roughly 27,400 hectares a day. That's 149 trees per second, every second, today.<span class="src">Source: Global Forest Watch · FAO Forest Resources Assessment</span></div>
        </div>
        <div class="truth-stat">
          <div class="big">80%</div>
          <div class="lbl">of terrestrial biodiversity lives in forests. When forests fall, so do the species that exist nowhere else.<span class="src">Source: UN Convention on Biological Diversity</span></div>
        </div>
        <div class="truth-stat">
          <div class="big">~10%</div>
          <div class="lbl">of global greenhouse-gas emissions come directly from deforestation and forest degradation.<span class="src">Source: IPCC AR6 · Working Group III</span></div>
        </div>
      </div>

      <div class="truth-section">
        <span class="truth-section-label">Australia · the quiet crisis</span>
        <div class="truth-stat">
          <div class="big">Top 5</div>
          <div class="lbl">deforesting nations in the developed world. Australia is the only OECD country on the global deforestation hotlist.<span class="src">Source: WWF Deforestation Fronts report</span></div>
        </div>
        <div class="truth-stat">
          <div class="big">50%</div>
          <div class="lbl">of Australia's forests have already been destroyed. Most of it on Country that was never ceded.<span class="src">Source: HalfCut Organisation · halfcut.org/about</span></div>
        </div>
        <div class="truth-stat">
          <div class="big">50%</div>
          <div class="lbl">of Australia's landmass is used for cattle. Forest clearing for pasture remains the single largest driver of habitat loss.<span class="src">Source: HalfCut Organisation · ABARES land-use survey</span></div>
        </div>
        <div class="truth-stat">
          <div class="big">50%</div>
          <div class="lbl">of Australia's land is under First Nations ownership, management, or co-management. The people who have cared for Country longest hold the deepest part of the answer.<span class="src">Source: HalfCut Organisation · National Native Title Tribunal</span></div>
        </div>
      </div>

      <div class="truth-section">
        <span class="truth-section-label">The Daintree · what we're protecting</span>
        <div class="truth-stat">
          <div class="big">120 M yrs</div>
          <div class="lbl">old. The Daintree Lowland Rainforest is the oldest tropical rainforest on Earth, and the largest continuous area of tropical rainforest remaining in Australia.<span class="src">Source: HalfCut Organisation · UNESCO Wet Tropics World Heritage Area</span></div>
        </div>
        <div class="truth-stat">
          <div class="big">203 ha</div>
          <div class="lbl">currently in active buyback. Daintree River Station, a once-in-a-generation rainforest acquisition, with 170+ hectares targeted for rewilding as cassowary habitat.<span class="src">Source: HalfCut Organisation · halfcut.org/impact</span></div>
        </div>
        <div class="truth-stat">
          <div class="big">150+</div>
          <div class="lbl">rainforest fruits eaten and dispersed by the Southern Cassowary. Without them, the seeds don't move, the forest doesn't regenerate. They're listed Vulnerable to extinction.<span class="src">Source: Australian Government · EPBC Act listing</span></div>
        </div>
      </div>

      <div class="truth-pull">
        <blockquote>
