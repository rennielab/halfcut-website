---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getFieldNotes, getImpactMetrics, getSiteSettings } from '~/lib/sanity';

// Build-time content. Missing Sanity = empty arrays = empty UI = no fabrication.
let settings: any = null;
let notes: any[] = [];
let metrics: any[] = [];
try {
  [settings, notes, metrics] = await Promise.all([
    getSiteSettings(),
    getFieldNotes(),
    getImpactMetrics(),
  ]);
} catch {
  // First boot, no Sanity project yet — render shell only.
}

const heroTitle = settings?.hero?.title ?? 'A bridge.\nNot a saviour.';
const heroLede = settings?.hero?.lede ??
  'HalfCut funds work that Eastern Kuku Yalanji Bama people lead, on Country they have always cared for. Profits return to the corporations who do the work.';
---

<BaseLayout
  title="HalfCut"
  description="HalfCut is a First Nations-led conservation charity protecting Australia's Daintree rainforest in partnership with the Eastern Kuku Yalanji Bama people and Jabalbina Yalanji Aboriginal Corporation."
  current="home"
  dark={true}
>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-inner">
      <span class="eyebrow">Estd 2017 · Daintree, Queensland · Sydney, NSW</span>
      <h1 class="hero-title">{heroTitle.split('\n').map((line: string, i: number) => (
        <span>{line}{i < heroTitle.split('\n').length - 1 && <br />}</span>
      ))}</h1>
      <p class="hero-lede">{heroLede}</p>
      <div class="hero-ctas">
        <a href="/donate" class="btn btn-acid">Resource the work →</a>
        <a href="/about" class="btn btn-secondary">How HalfCut works</a>
      </div>
    </div>
  </section>

  {metrics.length > 0 && (
    <section class="impact-strip">
      <div class="impact-strip-inner">
        {metrics.slice(0, 4).map((m: any) => (
          <div class="impact-stat">
            <span class="k">{m.label}</span>
            <span class="v">{m.value}{m.unit ? <small>{m.unit}</small> : null}</span>
            {m.source && <span class="note">Source: {m.source}</span>}
          </div>
        ))}
      </div>
    </section>
  )}

  {notes.length > 0 && (
    <section class="recent-notes">
      <div class="sec-head">
        <h2>Field Notes</h2>
        <a href="/fieldnotes" class="link">All notes →</a>
      </div>
      <div class="notes-grid">
        {notes.slice(0, 3).map((n: any) => (
          <a class="note-card" href={`/fieldnotes/${n.slug.current}`}>
            <span class="note-cat">{n.category}</span>
            <h3>{n.title}</h3>
            <p>{n.excerpt}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {notes.length === 0 && (
    <section class="seed-banner">
      <p>
        Sanity isn't connected yet. Once HalfCut's content is seeded, Field
        Notes and Impact metrics render here. Until then the homepage shows
        no claims this charity hasn't published.
      </p>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    overflow: hidden;
    background: var(--ink);
    color: var(--cream);
  }
  .hero-bg {
    position: absolute; inset: -10% 0;
    background-image: url('/assets-legacy/hero-jabalbina.jpg');
    background-size: cover; background-position: center;
    filter: brightness(.65) saturate(.95);
  }
  .hero::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(19,20,14,.2) 0%, rgba(19,20,14,.4) 40%, rgba(19,20,14,.85) 100%);
  }
  .hero-inner {
    position: relative; z-index: 2;
    max-width: 1200px; margin: 0 auto;
    padding: calc(var(--hero-pad-top, 160px) + 24px) var(--pad-x, 32px) var(--s-10, 128px);
    display: flex; flex-direction: column;
    min-height: 92vh; justify-content: flex-end;
  }
  .hero .eyebrow { color: var(--acid); margin-bottom: var(--s-5, 24px); display: block; }
  .hero-title {
    font-family: var(--f-display);
    font-size: clamp(64px, 10vw, 200px);
    line-height: .88;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    text-wrap: balance;
    margin: 0 0 var(--s-6, 32px);
    max-width: 14ch;
  }
  .hero-lede {
    font-family: var(--f-serif);
    font-weight: 300;
    font-size: clamp(18px, 1.6vw, 24px);
    line-height: 1.4;
    max-width: 56ch;
    opacity: .9;
    margin: 0 0 var(--s-7, 48px);
  }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .seed-banner {
    background: var(--stone);
    padding: var(--s-7, 48px) var(--pad-x, 32px);
    text-align: center;
    font-family: var(--f-serif);
    font-weight: 300;
    font-size: 16px;
    opacity: .7;
  }
  .seed-banner p { max-width: 56ch; margin: 0 auto; }
</style>
