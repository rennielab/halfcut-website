---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title="HalfCut"
  description="HalfCut is a First Nations-led conservation charity protecting Australia\'s Daintree rainforest in partnership with the Eastern Kuku Yalanji Bama people and Jabalbina Yalanji Aboriginal Corporation."
  current="home"
  dark={true}
>
<!-- =================== HERO =================== -->
<section class="hero" data-screen-label="01 Home · Hero">
  <div class="hero-bg" id="heroBg" data-parallax="0.15"></div>
  <div class="hero-grain"></div>
  <div class="hero-inner">
    <h1 class="manifesto">
      Protect. Restore. Forever.
    </h1>

    <div class="hero-tracker hero-tracker-below" aria-label="Live forest loss tracker">
      <div class="hero-tracker-head">
        <span>Global forest loss</span>
        <span class="live">Live</span>
      </div>
      <div class="hero-tracker-row">
        <span class="lbl">Hectares lost today</span>
        <span class="val" id="trk-ha">0<span class="u">ha</span></span>
      </div>
      <div class="hero-tracker-row">
        <span class="lbl">Trees lost since you arrived</span>
        <span class="val" id="trk-trees">0</span>
      </div>
      <div class="hero-tracker-foot">Source: FAO + GFW · updates on landing</div>
    </div>

    <div class="hero-bottom">
      <p class="hero-lede">
        The movement helping Australians meet nature halfway.
      </p>
    </div>
  </div>
</section>

<!-- =================== BRIDGE POSITION =================== -->
<section class="bridge" data-screen-label="01 Home · Bridge">
  <div class="bridge-grid">
    <div class="bridge-copy">
      <h2 class="bridge-headline">
        We are the <span class="mark">bridge</span> not<br>
        the saviour.
      </h2>
      <p class="bridge-lede">
        HalfCut doesn't lead restoration work. We resource the people who already do, the
        Traditional Owner corporations whose knowledge of this Country predates every map,
        every border, every treaty.
      </p>
      <p class="bridge-body">
        Our job is to raise the money, hold the governance, publish the audit, and get out
        of the way. It's quieter than the usual charity story, and it's the only version
        we think is honest.
      </p>
      <div class="bridge-sig">
        <div class="bridge-sig-name">Jimmy Stanton-Cooke</div>
        <div class="bridge-sig-role">Co-Founder &amp; CEO · In partnership with Jabalbina Yalanji Aboriginal Corporation</div>
      </div>
    </div>

    <figure class="bridge-figure" aria-hidden="false">
      <div class="bridge-figure-grid" id="bridgeImg">
        <img src="/assets-legacy/portrait-1.png" alt="HalfCut community portrait" loading="lazy">
        <img src="/assets-legacy/portrait-2.png" alt="HalfCut community portrait" loading="lazy">
        <img src="/assets-legacy/portrait-3.png" alt="HalfCut community portrait" loading="lazy">
        <img src="/assets-legacy/portrait-4.png" alt="HalfCut community portrait" loading="lazy">
      </div>
      <div class="bridge-figure-tag">Faces of the movement · 2014–2025</div>
    </figure>
  </div>

  <!-- Giant background numeral (Inversa-style section marker) -->
  <div class="bridge-bignum" aria-hidden="true">02</div>
</section>

<!-- =================== PILLARS (cinematic scroll) =================== -->
<div class="pillars">

  <section class="pillar" data-screen-label="01 Home · Pillar 1">
    <div class="pillar-text">
      <h2>The Oldest<br>Rainforest<br>on Earth.</h2>
      <p>
        The Daintree has stood for 180 million years. It holds species that exist nowhere else on this planet.
        It holds the stories, the law, and the lived relationship of the Kuku Yalanji people, who have belonged
        to it for thousands of generations.
      </p>
    </div>
    <div class="pillar-media">
      <img src="/photos/photo_001.webp" alt="Tropical rainforest interior, dense canopy">
      </div>
  </section>

  <section class="pillar reverse" data-screen-label="01 Home · Pillar 2">
    <div class="pillar-text">
      <h2>Led on<br>Country, by<br>Country.</h2>
      <p>
        Every dollar raised moves through a governance model developed with Jabalbina Yalanji Aboriginal Corporation.
        The decisions about what to restore, how to restore it, and what comes next are made by the people
        whose knowledge makes the work possible.
      </p>
    </div>
    <div class="pillar-media">
      <img src="/photos/photo_074.webp" alt="Tropical rainforest creek, Wet Tropics">
      </div>
  </section>

  <section class="pillar" data-screen-label="01 Home · Pillar 3">
    <div class="pillar-text">
      <h2>Half cut,<br>full<br>blown.</h2>
      <p>
        Every August, thousands of people shave half their head and wear the mission for a month.
        It's a walking conversation. A ridiculous, participatory act that has resourced millions of dollars
        of restoration work since 2014.
      </p>
    </div>
    <div class="pillar-media">
      <img src="/assets-legacy/halfcut-beard.avif" alt="The HalfCut, half-shaved beard, half-shaved head">
      </div>
  </section>
</div>

<!-- =================== MAP, HORIZONTAL SCROLL-JACK (3 chapters) =================== -->
<!-- =================== CAMPAIGN BAND =================== -->
<section class="campaign" data-screen-label="01 Home · August">
  <div class="campaign-portrait" aria-hidden="true">
    <img src="/assets-legacy/halfcut-beard.avif" alt="" loading="lazy">
  </div>
  <div class="campaign-inner">
    <div class="campaign-top">
      <a href="#" class="tag">Register interest →</a>
    </div>
    <h2><span class="split">HALF</span><br>CUT IN</h2>
    <div class="campaign-row reveal">
      <p>
        Since 2014, the shave has turned personal commitment into collective power. One month, half a head,
        an entire country paying attention. This year we're shaving for the restoration of 1,200 hectares of
        Kuku Yalanji Country, with every dollar flowing through Jabalbina's direction.
      </p>
      <div>
        <h4>Raised to date</h4>
        <div class="stat">$4.2<span style="font-size:.5em;">M</span></div>
        <div class="stat-sub">across twelve August campaigns</div>
      </div>
      <div>
        <h4>Participants</h4>
        <div class="stat">11,400+</div>
        <div class="stat-sub">half-cut heads, 47 countries</div>
      </div>
    </div>
    <div class="marquee">
      <div class="marquee-track">
        <span>Shave in August</span><span class="dot"></span>
        <span>Half a head. All the conversations.</span><span class="dot"></span>
        <span>Led by Country</span><span class="dot"></span>
        <span>Resourced by you</span><span class="dot"></span>
        <span>Shave in August</span><span class="dot"></span>
        <span>Half a head. All the conversations.</span><span class="dot"></span>
        <span>Led by Country</span><span class="dot"></span>
        <span>Resourced by you</span><span class="dot"></span>
      </div>
    </div>
  </div>
</section>

<!-- =================== PROJECTS STRIP =================== -->
