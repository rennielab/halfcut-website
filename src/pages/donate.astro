---
import BaseLayout from '~/layouts/BaseLayout.astro';

const whereItGoes = [
  'Protect forests and important landscapes forever',
  'Restore degraded forests and native habitat',
  'Support First Nations-led healing of Country',
  'Create ranger and First Nations employment',
  'Protect biodiversity and threatened species',
  'Support land acquisition and return to Country',
  'Fund scientific research and ecological monitoring',
  'Help create affordable housing and infrastructure on Country',
];

const bequestKinds = [
  'A percentage of your estate',
  'A specific amount',
  'Property, shares or other assets',
  'The remainder of your estate after loved ones have been provided for',
];
---

<BaseLayout
  title="Donate"
  description="Give today. Leave a legacy for tomorrow. Nature for Life gives you the opportunity to protect forests still standing and restore forests already lost."
  current="donate"
  dark={true}
>
  <section class="dn-split" id="donate-now">
    <div class="dn-split-bg-wrap" aria-hidden="true">
      <div class="dn-split-bg" data-parallax="0.10"></div>
      <div class="dn-split-veil"></div>
    </div>
    <div class="dn-split-inner">
      <aside class="dn-split-copy">
          <div class="dn-match" role="note" aria-label="Match giving live now">
            <span class="dn-match-kicker">Live match, summit 2026</span>
            <p class="dn-match-headline">Every dollar matched to $10,000.</p>
            <p class="dn-match-body">Every donation is matched dollar for dollar until we hit $10,000. Give today and your gift counts twice.</p>
            <div class="dn-match-by">
              <span>Matched by</span>
              <img src="/sponsors/greenpay-ink.webp" alt="GreenPay" width="112" height="20" />
            </div>
          </div>
          <h1>Give to nature.<br />For life.</h1>
          <p class="lede">
            Nature has supported us throughout our lives. Nature for Life gives
            you the opportunity to give something meaningful back by protecting
            forests that are still standing and restoring forests that have
            already been lost.
          </p>
          <div class="dn-hero-ctas">
            <a href="#legacy" class="btn btn-acid btn-xl">Leave a legacy</a>
            <a href="#bank" class="btn btn-xl btn-on-dark btn-primary">Bank transfer</a>
          </div>
          <p class="dn-split-note">
            Secured and processed via GreenPay (EzyRaise). Tax-deductible in
            Australia. ABN 24&nbsp;642&nbsp;788&nbsp;814.
          </p>
      </aside>
      <div class="dn-split-form">
        <iframe
          id="ez-chill-region-donation-widget"
          src="https://halfcut.ezyraise.site/widget/payment"
          style="border: none; overflow: hidden; width: 100%; height: 1050px;"
          allowfullscreen
          allow="payment"
          title="HalfCut donation form">
        </iframe>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const iframe = document.getElementById("ez-chill-region-donation-widget");
      if (!iframe) return;
      let isScrollEventFirstTime = true;
      window.addEventListener("message", function (event) {
        const data = event.data || {};
        if (data.message === "getDonationWidgetIframeHeight") {
          const height = data.height;
          if (height && !isNaN(height) && iframe.style) {
            iframe.style.height = (height + 10) + "px";
          }
        } else if (data.message === "scrollDonationWidgetIframeToTop") {
          if (!isScrollEventFirstTime) {
            iframe.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
          isScrollEventFirstTime = false;
        }
      });
      iframe.addEventListener("load", function () {
        if (iframe.contentWindow) {
          iframe.contentWindow.postMessage({ message: "getDonationWidgetIframeHeight" }, "*");
        }
      });
    })();
  </script>

  <section class="dn-partner" aria-label="Match giving partnership with GreenPay">
    <div class="dn-partner-bg" aria-hidden="true" data-parallax="0.08"></div>
    <div class="dn-partner-veil" aria-hidden="true"></div>
    <div class="dn-partner-inner">
      <div class="dn-partner-copy">
        <span class="dn-partner-kicker">In partnership with, Summit 2026</span>
        <h2>$10,000 matched into the world&rsquo;s forests.</h2>
        <p>
          GreenPay is matching every donation dollar for dollar until we hit
          $10,000. Every gift you make today plants twice.
        </p>
      </div>
      <div class="dn-partner-mark">
        <img
          src="/sponsors/greenpay-cream.webp"
          alt="GreenPay"
          width="360" height="64"
        />
      </div>
    </div>
  </section>

  <section class="dn-bank" id="bank">
    <div class="dn-bank-inner">
      <div class="dn-bank-copy">
        <h2>Donate by bank transfer.</h2>
        <p>
          Make a tax-deductible donation directly to the HalfCut Ltd Fund
          through Bank Australia. Your donation will help HalfCut protect
          forests that are still standing, restore forests that have been lost,
          and support First Nations-led projects through Heal Country. Heal
          Culture.
        </p>
        <p class="dn-bank-note">
          After making your donation, please contact HalfCut with your name,
          donation amount and payment reference so we can issue your
          tax-deductible receipt.
        </p>
        <div class="dn-bank-emails">
          <a href="mailto:jimmy@halfcut.org">jimmy@halfcut.org</a>
        </div>
      </div>
      <div class="dn-bank-details">
        <h3>Bank transfer details</h3>
        <dl>
          <dt>Account name</dt><dd>HalfCut Ltd Fund</dd>
          <dt>Bank</dt><dd>Bank Australia</dd>
          <dt>BSB</dt><dd>313 140</dd>
          <dt>Account number</dt><dd>1228 8121</dd>
          <dt>Reference</dt><dd>Your name or organisation</dd>
        </dl>
      </div>
    </div>
  </section>

  <section class="dn-where">
    <div class="dn-where-inner">
      <h2>Where your donation goes.</h2>
      <div class="dn-where-list">
        {whereItGoes.map((item) => <div class="dn-where-row">{item}</div>)}
      </div>
      <div class="dn-where-close">
        <p class="dn-where-headline">Protect. Restore. Forever.</p>
        <p>Every donation supports the two halves of HalfCut. Protect forests that are still standing. Restore forests that have already been lost.</p>
      </div>
    </div>
  </section>

  <section class="dn-legacy" id="legacy">
    <div class="dn-legacy-inner">
      <h2>Leave a gift in your Will.</h2>
      <p class="dn-legacy-lede">
        Protect and restore nature beyond your lifetime.
      </p>
      <p>
        A gift in your Will, also known as a bequest, is a powerful way to
        continue supporting the places, people and wildlife you care about.
      </p>
      <p>
        Your bequest can help HalfCut protect forests forever, restore
        degraded Country, protect biodiversity and support First Nations
        communities to lead the healing of Country and Culture.
      </p>
      <p>You may choose to leave:</p>
      <div class="dn-legacy-list">
        {bequestKinds.map((k) => <div class="dn-legacy-row">{k}</div>)}
      </div>
      <p class="dn-legacy-note">
        Even a small percentage can create lasting impact. We recommend
        discussing your wishes with your solicitor or qualified legal adviser
        to ensure your Will accurately reflects your intentions.
      </p>
      <a href="#legacy-form" class="btn btn-primary btn-xl">Request bequest information</a>
    </div>
  </section>

  <section class="dn-lifetime">
    <div class="dn-lifetime-inner">
      <h2>See your legacy in your lifetime.</h2>
      <p class="dn-lifetime-lede">
        Give in life. Experience the impact. Leave a legacy.
      </p>
      <p>
        You do not have to wait to see the difference your legacy can make.
        We invite prospective bequest supporters to consider making a donation
        during their lifetime and joining a HalfCut Yalada Tour to experience
        the impact firsthand.
      </p>
      <p>
        Walk on Country. Meet the people leading the work. Visit rainforest
        restoration and protection projects. Plant a tree and see how your
        support can help heal Country, strengthen Culture and protect nature
        forever.
      </p>
      <a href="/yalada-tours" class="btn btn-acid btn-xl">Explore Yalada Tours</a>
    </div>
  </section>

  <section class="dn-legacy-form" id="legacy-form">
    <div class="dn-legacy-form-inner">
      <div class="lhs">
        <h2>Talk to us about your legacy.</h2>
        <p>
          A bequest is personal. We would be honoured to speak with you
          privately about the kind of impact you would like to create.
        </p>
        <p class="dn-legacy-note">
          There is no obligation to disclose the value of your intended gift.
          Letting us know about your intentions allows us to thank you, keep
          you connected with our work and invite you to experience your
          impact during your lifetime.
        </p>
      </div>
      <form class="dn-form" action="https://formsubmit.co/jimmy@halfcut.org" method="POST">
        <h3>Expression of Interest</h3>
        <div class="grid2">
          <div class="field"><span class="label">Name</span><input type="text" name="name" required /></div>
          <div class="field"><span class="label">Email</span><input type="email" name="email" required /></div>
        </div>
        <div class="grid2">
          <div class="field"><span class="label">Phone</span><input type="tel" name="phone" /></div>
          <div class="field">
            <span class="label">Preferred contact</span>
            <select name="contact-pref">
              <option>Email</option><option>Phone</option>
            </select>
          </div>
        </div>
        <div class="field">
          <span class="label">I am interested in</span>
          <div class="checkbox-grid">
            {['Making a donation during my lifetime','Leaving a gift in my Will','Joining a Yalada Tour','Supporting forest protection','Supporting rainforest restoration','Supporting Heal Country. Heal Culture.','Supporting biodiversity and threatened species','Discussing a major gift','Receiving more information'].map((c) => (
              <label class="chk"><input type="checkbox" name="interest[]" value={c} />{c}</label>
            ))}
          </div>
        </div>
        <div class="field">
          <span class="label">Message</span>
          <textarea name="message" rows="4"></textarea>
        </div>
        <button type="submit" class="btn btn-acid btn-xl">Start a conversation</button>
      </form>
    </div>
  </section>

  <section class="dn-close">
    <div class="dn-close-inner">
      <h2>Protect. Restore. Forever.</h2>
      <p>
        Your life can leave more than memories. It can leave forests standing,
        degraded landscapes restored, wildlife protected, Country returned and
        First Nations communities supported to care for land and Culture for
        generations to come.
      </p>
      <p class="dn-close-line">Give to nature. For life.</p>
      <div class="dn-close-ctas">
        <a href="#donate-now" class="btn btn-acid btn-xl">Donate now</a>
        <a href="#legacy-form" class="btn btn-xl on-ink btn-secondary">Leave a legacy</a>
      </div>
    </div>
  </section>

  <section class="dn-trust">
    <div class="dn-trust-inner">
      <div><div class="label">Tax status</div><h4>DGR · ABN 24 642 788 814</h4><p>Public Benevolent Institution. Gifts over $2 tax-deductible in Australia.</p></div>
      <div><div class="label">Audit</div><h4>BDO Australia</h4><p>Every figure on the Impact page independently audited annually.</p></div>
      <div><div class="label">Security</div><h4>GreenPay + Stripe</h4><p>PCI DSS Level 1. We never see your card details.</p></div>
      <div><div class="label">Other ways</div><h4>Payroll, bequest, crypto</h4><p>Speak to us about larger or structured gifts. Contact Jimmy directly.</p></div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .accent { color: var(--acid); }

  /* Split hero: headline sticky on the left, GreenPay form on the right.
     Single continuous dark section — no lighter beige band between hero and
     form. Left column stays visible while user scrolls the (tall) iframe. */
  /* NB: no overflow:hidden on .dn-split itself — that would kill the
     position:sticky on the left column. The bg + parallax lives inside a
     nested wrapper that owns the clip. */
  .dn-split {
    position: relative;
    background: var(--ink); color: var(--cream);
  }
  .dn-split-bg-wrap {
    position: absolute; inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .dn-split-bg {
    position: absolute; inset: -6% 0;
    background-image: url('/photos/photo_063.webp');
    background-size: cover; background-position: center;
    filter: brightness(.45) saturate(.9);
    will-change: transform;
  }
  .dn-split-veil {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(19,20,14,.55) 0%, rgba(19,20,14,.55) 100%);
  }
  .dn-split-inner {
    position: relative; z-index: 2;
    max-width: 1440px; margin: 0 auto;
    padding: calc(var(--hero-pad-top) + 8px) var(--pad-x) var(--s-9);
    display: grid; grid-template-columns: 1fr 1fr;
    gap: var(--s-8);
    align-items: start;        /* sticky grid child needs align-items:start */
  }
  /* Sticky directly on the grid cell — this is the reliable pattern.
     Grid parent uses align-items:start so the sticky respects its own size.
     Element sticks to top:188px as user scrolls through the tall iframe. */
  .dn-split-copy {
    position: sticky;
    top: calc(var(--hero-pad-top) + 8px);
    max-width: 44ch;
  }
  /* Match-giving callout: flat acid block, dark ink text. Sits above the
     H1 in the sticky column so it stays in view while people scroll the
     GreenPay iframe. Reads as a live status, not a decorative badge. */
  .dn-match {
    background: var(--acid);
    color: var(--ink);
    padding: 18px 22px 20px;
    margin: 0 0 var(--s-6);
    max-width: 44ch;
  }
  .dn-match-kicker {
    display: block;
    font-family: var(--f-sans); font-weight: 700;
    font-size: 11px; letter-spacing: .18em;
    text-transform: uppercase;
    margin-bottom: 8px;
    opacity: .85;
  }
  .dn-match-headline {
    font-family: var(--f-display);
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.05; letter-spacing: -0.015em;
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .dn-match-body {
    font-family: var(--f-serif); font-weight: 400;
    font-size: 15px; line-height: 1.5;
    margin: 0;
    max-width: 42ch;
  }
  .dn-match-by {
    display: flex; align-items: center; gap: 10px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid rgba(19,20,14,.18);
  }
  .dn-match-by span {
    font-family: var(--f-sans); font-weight: 700;
    font-size: 10px; letter-spacing: .18em;
    text-transform: uppercase;
    opacity: .75;
  }
  .dn-match-by img {
    display: block;
    height: 20px; width: auto;
    max-width: 140px;
    object-fit: contain;
  }

  .dn-split-copy h1 {
    font-family: var(--f-display);
    font-size: clamp(52px, 6vw, 120px);
    line-height: .9; letter-spacing: -0.025em;
    text-transform: uppercase;
    margin: 0 0 var(--s-6);
    color: var(--cream);
  }
  .dn-split-copy .lede {
    font-family: var(--f-serif); font-weight: 300;
    font-size: clamp(18px, 1.4vw, 22px); line-height: 1.5;
    color: var(--cream); opacity: .92;
    margin: 0 0 var(--s-6);
  }
  .dn-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: var(--s-5); }
  .dn-split-note {
    font-family: var(--f-sans); font-weight: 600;
    font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--cream); opacity: .55;
    max-width: 44ch; margin: 0;
  }
  /* No cream frame around the iframe — let GreenPay render edge-to-edge */
  .dn-split-form { background: transparent; }
  .dn-split-form iframe { display: block; width: 100%; min-height: 1050px; border: 0; background: transparent; }

  @media (max-width: 960px) {
    .dn-split-inner { grid-template-columns: 1fr; padding: calc(var(--hero-pad-top-sm) + 8px) var(--pad-x) var(--s-8); }
    .dn-split-copy { position: static; top: auto; margin-bottom: var(--s-6); }
  }

  /* Partnership banner: bridges the donate hero and the bank section with
     a full-bleed dark rainforest moment. Big GreenPay mark, one clear
     statement about the $10K match. No shadow, no left stripe, single
     acid accent on the kicker. */
  .dn-partner {
    position: relative; overflow: hidden;
    background: var(--ink); color: var(--cream);
    padding: var(--s-10) var(--pad-x);
  }
  .dn-partner-bg {
    position: absolute; inset: -6% 0;
    background-image: url('/photos/photo_045.webp');
    background-size: cover; background-position: center;
    filter: brightness(.42) saturate(.9);
    will-change: transform;
    z-index: 0;
  }
  .dn-partner-veil {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(19,20,14,.75) 0%, rgba(19,20,14,.55) 100%);
    z-index: 1;
  }
  .dn-partner-inner {
    position: relative; z-index: 2;
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: 1.4fr 1fr;
    gap: var(--s-8); align-items: center;
  }
  .dn-partner-kicker {
    display: block;
    font-family: var(--f-sans); font-weight: 700;
    font-size: 11px; letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--acid);
    margin-bottom: var(--s-4);
  }
  .dn-partner-copy h2 {
    font-family: var(--f-display);
    font-size: clamp(36px, 4.5vw, 68px);
    line-height: .95; letter-spacing: -0.02em; text-transform: uppercase;
    margin: 0 0 var(--s-5);
    color: var(--cream);
  }
  .dn-partner-copy p {
    font-family: var(--f-serif); font-weight: 300;
    font-size: clamp(17px, 1.4vw, 20px); line-height: 1.55;
    color: var(--cream); opacity: .88;
    margin: 0; max-width: 52ch;
  }
  .dn-partner-mark {
    display: flex; align-items: center; justify-content: center;
    padding: var(--s-5) 0;
  }
  .dn-partner-mark img {
    display: block;
    width: 100%; max-width: 360px; height: auto;
  }
  @media (max-width: 900px) {
    .dn-partner-inner { grid-template-columns: 1fr; gap: var(--s-6); }
    .dn-partner-mark { justify-content: flex-start; padding: 0; }
    .dn-partner-mark img { max-width: 240px; }
  }

  .dn-bank { background: var(--cream); padding: var(--s-10) var(--pad-x); }
  .dn-bank-inner {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--s-8);
    align-items: start;
  }
  .dn-bank-copy h2 { font-family: var(--f-display); font-size: clamp(36px, 5vw, 64px); line-height: 1; letter-spacing: -0.02em; text-transform: uppercase; margin: 0 0 var(--s-5); }
  .dn-bank-copy p { font-family: var(--f-serif); font-weight: 300; font-size: 18px; line-height: 1.55; margin: 0 0 var(--s-4); max-width: 56ch; }
  .dn-bank-note { opacity: .75; }
  .dn-bank-emails { font-family: var(--f-sans); font-weight: 700; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; display: flex; gap: 12px; align-items: center; margin-top: var(--s-4); }
  .dn-bank-emails a { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--coral); }
  .dn-bank-details {
    background: var(--stone);
    padding: var(--s-6); border-radius: 4px;
  }
  .dn-bank-details h3 { font-family: var(--f-display); font-size: 22px; text-transform: uppercase; letter-spacing: -0.01em; margin: 0 0 var(--s-4); }
  .dn-bank-details dl { display: grid; grid-template-columns: 140px 1fr; gap: 8px 16px; margin: 0; }
  .dn-bank-details dt { font-family: var(--f-sans); font-weight: 700; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; opacity: .55; align-self: center; }
  .dn-bank-details dd { margin: 0; font-family: var(--f-serif); font-weight: 400; font-size: 17px; }
  @media (max-width: 900px) { .dn-bank-inner { grid-template-columns: 1fr; } }

  .dn-where { background: var(--ink); color: var(--cream); padding: var(--s-10) var(--pad-x); }
  .dn-where-inner { max-width: 1000px; margin: 0 auto; }
  .dn-where h2 { font-family: var(--f-display); font-size: clamp(40px, 5vw, 80px); line-height: 1; letter-spacing: -0.02em; text-transform: uppercase; margin: 0 0 var(--s-7); }
  .dn-where-list { display: flex; flex-direction: column; gap: 0; }
  .dn-where-row {
    padding: var(--s-4) 0;
    border-top: 1px solid var(--cream-15);
    font-family: var(--f-serif); font-weight: 400;
    font-size: clamp(17px, 1.4vw, 22px); line-height: 1.4;
  }
  .dn-where-row:last-child { border-bottom: 1px solid var(--cream-15); }
  .dn-where-close { margin-top: var(--s-8); }
  .dn-where-headline { font-family: var(--f-display); font-size: clamp(28px, 3.5vw, 48px); line-height: 1; letter-spacing: -0.015em; text-transform: uppercase; margin: 0 0 var(--s-4); }
  .dn-where-close p:last-child { font-family: var(--f-serif); font-weight: 300; font-size: 18px; line-height: 1.55; opacity: .85; max-width: 56ch; margin: 0; }

  .dn-legacy { background: var(--stone); color: var(--ink); padding: var(--s-10) var(--pad-x); }
  .dn-legacy-inner { max-width: 800px; margin: 0 auto; }
  .dn-legacy h2 { font-family: var(--f-display); font-size: clamp(40px, 5vw, 84px); line-height: 1; letter-spacing: -0.02em; text-transform: uppercase; margin: 0 0 var(--s-4); }
  .dn-legacy-lede, .dn-lifetime-lede { font-family: var(--f-serif); font-weight: 400; font-size: clamp(20px, 1.8vw, 28px); line-height: 1.35; margin: 0 0 var(--s-6); }
  .dn-legacy p { font-family: var(--f-serif); font-weight: 300; font-size: 18px; line-height: 1.55; margin: 0 0 var(--s-4); }
  .dn-legacy-list { display: flex; flex-direction: column; margin: var(--s-4) 0; }
  .dn-legacy-row {
    padding: 12px 0;
    border-top: 1px solid var(--ink-15);
    font-family: var(--f-serif); font-weight: 400; font-size: 17px;
  }
  .dn-legacy-row:last-child { border-bottom: 1px solid var(--ink-15); }
  .dn-legacy-note { opacity: .75; font-size: 16px !important; margin-top: var(--s-4) !important; }

  .dn-lifetime { background: var(--cream); color: var(--ink); padding: var(--s-10) var(--pad-x); }
  .dn-lifetime-inner { max-width: 800px; margin: 0 auto; }
  .dn-lifetime h2 { font-family: var(--f-display); font-size: clamp(40px, 5vw, 84px); line-height: 1; letter-spacing: -0.02em; text-transform: uppercase; margin: 0 0 var(--s-4); }
  .dn-lifetime p { font-family: var(--f-serif); font-weight: 300; font-size: 18px; line-height: 1.55; margin: 0 0 var(--s-4); }

  .dn-legacy-form { background: var(--ink); color: var(--cream); padding: var(--s-10) var(--pad-x); }
  .dn-legacy-form-inner {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--s-8);
  }
