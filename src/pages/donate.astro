---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Donate"
  description="Resource Eastern Kuku Yalanji Bama-led conservation. Tax-deductible in Australia."
  current="donate"
  
>
<section class="donate-hero" data-screen-label="06 Donate · Hero">
  <div class="donate-hero-inner">
    <span class="eyebrow">Donate</span>
    <h1>Resource<br>the work.</h1>
  </div>
</section>

<div class="donate-body">
  <aside class="donate-context" data-screen-label="06 Donate · Context">
    <h3>Where your<br>money goes.</h3>
    <p>
      Every dollar moves through governance developed with Jabalbina. 92¢ reaches Country. 5¢ funds the programs that get more money to Country. 3¢ keeps the lights on.
    </p>
    <p>
      Donations over $2 are tax-deductible in Australia. We are a registered Public Benevolent Institution with DGR status.
    </p>
    <div class="ctx-stats">
      <div><div class="n">92¢</div><div class="l">To Country</div></div>
      <div><div class="n">$4.2M</div><div class="l">Raised since 2014</div></div>
      <div><div class="n">1,200 ha</div><div class="l">Under restoration</div></div>
      <div><div class="n">BDO</div><div class="l">Independently audited</div></div>
    </div>
  </aside>

  <div class="donate-panel" data-screen-label="06 Donate · Form">
    <h3>Make a contribution.</h3>
    <div class="sub">Secured and processed via GreenPay (EzyRaise).</div>

    <div class="greenpay-embed">
      <iframe
        id="ez-chill-region-donation-widget"
        src="https://halfcut.ezyraise.site/widget/payment"
        style="border: none; overflow: hidden; width: 100%; height: 1050px;"
        allowfullscreen
        allow="payment"
        title="HalfCut donation form">
      </iframe>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const iframe = document.getElementById("ez-chill-region-donation-widget");
    if (!iframe) return;
    let isScrollEventFirstTime = true;
    window.addEventListener("message", function (event) {
      const data = event.data || {};
      if (data.message === "getDonationWidgetIframeHeight") {
        const height = data.height;
        if (height && !isNaN(height) && iframe.style) {
          iframe.style.height = (height + 10) + "px";
        }
      } else if (data.message === "scrollDonationWidgetIframeToTop") {
        if (!isScrollEventFirstTime) {
          iframe.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        isScrollEventFirstTime = false;
      }
    });
    iframe.addEventListener("load", function () {
      if (iframe.contentWindow) {
        iframe.contentWindow.postMessage({ message: "getDonationWidgetIframeHeight" }, "*");
      }
    });
  })();
</script>

<section class="trust" data-screen-label="06 Donate · Trust">
  <div class="trust-inner">
    <div>
      <div class="label">Tax status</div>
      <h4>DGR · ABN 24 642 788 814</h4>
      <p>Public Benevolent Institution. Gifts over $2 tax-deductible in Australia.</p>
    </div>
    <div>
      <div class="label">Audit</div>
      <h4>BDO Australia</h4>
      <p>Every figure on the Impact page independently audited annually.</p>
    </div>
    <div>
      <div class="label">Security</div>
      <h4>GreenPay + Stripe</h4>
      <p>PCI DSS Level 1. We never see your card details.</p>
    </div>
    <div>
      <div class="label">Other ways</div>
      <h4>Payroll, bequest, crypto</h4>
      <p>Speak to us about larger or structured gifts, contact Jimmy directly.</p>
    </div>
  </div>
</section>


</BaseLayout>

<style is:global>
.donate-hero {
    padding: var(--hero-pad-top-sm) var(--pad-x) var(--hero-pad-bottom-sm);
    background: var(--ink); color: var(--cream);
    border-bottom: 1px solid var(--cream-15);
  }
  .donate-hero-inner { max-width: 1440px; margin: 0 auto; }
  .donate-hero .eyebrow { color: var(--acid); margin-bottom: 20px; display: block; }
  .donate-hero h1 { font-family: var(--f-display); font-size: clamp(64px, 9vw, 180px); line-height: .9; letter-spacing: -0.025em; text-transform: uppercase; max-width: 14ch; }

  .donate-body {
    max-width: 1440px; margin: 0 auto;
    padding: var(--s-8) var(--pad-x) var(--s-10);
    display: grid; grid-template-columns: 1fr 1.3fr; gap: var(--s-8); align-items: start;
  }
  .donate-context { position: sticky; top: 40px; }
  .donate-context h3 { font-family: var(--f-display); font-size: 32px; letter-spacing: -0.01em; text-transform: uppercase; margin-bottom: 16px; }
  .donate-context p { font-family: var(--f-serif); font-weight: 300; font-size: 19px; line-height: 1.5; opacity: .8; margin-bottom: var(--s-5); max-width: 38ch; }
  .ctx-stats {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2px;
    background: var(--ink-15); border: 1px solid var(--ink-15);
    margin-top: var(--s-5);
  }
  .ctx-stats > div { background: var(--cream); padding: 20px; }
  .ctx-stats .n { font-family: var(--f-display); font-size: 36px; letter-spacing: -0.01em; line-height: 1; margin-bottom: 6px; }
  .ctx-stats .l { font-family: var(--f-sans); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; opacity: .55; }

  /* GreenPay iframe embed. The iframe self-reports its content height via
     postMessage; the inline script above resizes accordingly. Min-height
     keeps a stable box before the first message arrives. */
  .greenpay-embed {
    background: var(--cream);
    border-radius: 4px;
    overflow: hidden;
  }
  .greenpay-embed iframe {
    display: block;
    width: 100%;
    min-height: 1050px;
    border: 0;
  }

  /* Donate panel */
  .donate-panel {
    background: var(--cream);
    padding: var(--s-7);
    border: 1px solid var(--ink-15);
    border-radius: 4px;
  }
  .donate-panel h3 { font-family: var(--f-display); font-size: 28px; letter-spacing: -0.01em; text-transform: uppercase; margin-bottom: 4px; }
  .donate-panel .sub { font-family: var(--f-serif);  opacity: .6; margin-bottom: var(--s-5); font-size: 15px; }

  /* Trust strip */
  .trust {
    background: var(--cream); border-top: 1px solid var(--ink-15);
    padding: var(--s-7) var(--pad-x);
  }
  .trust-inner {
    max-width: 1440px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-5);
  }
  .trust-inner > div { padding: 0; }
  .trust-inner .label { font-family: var(--f-sans); font-weight: 600; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; opacity: .5; margin-bottom: 8px; }
  .trust-inner h4 { font-family: var(--f-display); font-size: 20px; letter-spacing: -0.005em; margin-bottom: 6px; text-transform: uppercase; }
  .trust-inner p { font-family: var(--f-serif); font-size: 15px; font-weight: 300; line-height: 1.4; opacity: .7; }

  @media (max-width: 960px) {
    .donate-body { grid-template-columns: 1fr; padding: var(--s-6) 24px; }
    .donate-context { position: static; }
    .trust-inner { grid-template-columns: 1fr 1fr; }
  }
</style>
