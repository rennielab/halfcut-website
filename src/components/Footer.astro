---
/**
 * Site footer. Acknowledgment of Country at the top — non-negotiable for a
 * First Nations-led organisation. Sponsor logos render on every page.
 */
import { getPartners } from '~/lib/sanity';

let partners: any[] = [];
try {
  partners = await getPartners();
} catch {
  partners = [];
}

// Confirmed sponsors, sourced from Ben's Halfcut logos folder and processed
// to mono cream silhouettes on transparent WebP. Order alphabetical.
const sponsors = [
  { slug: 'all-stripped',   name: 'All Stripped Demolition' },
  { slug: 'ben-and-jerrys', name: "Ben & Jerry's" },
  { slug: 'flow',           name: 'Flow' },
  { slug: 'greenpay',       name: 'GreenPay' },
  { slug: 'luminary',       name: 'Luminary' },
  { slug: 'macpac',         name: 'Macpac' },
  { slug: 'orchy',          name: 'Orchy' },
  { slug: 'rennie',         name: 'Rennie' },
];
---

<footer class="site-footer">
  <div class="footer-aoc">
    <p>
      HalfCut acknowledges the Eastern Kuku Yalanji Bama people as Traditional
      Owners of the rainforest country we work alongside, and the Gadigal people
      of the Eora nation on whose Country our studio sits. We pay respect to
      Elders past and present. Sovereignty has never been ceded.
    </p>
  </div>

  <div class="footer-grid">
    <nav class="footer-col" aria-label="Act">
      <h4>Act</h4>
      <a href="/go-halfcut">Go HalfCut</a>
      <a href="/donate">Donate</a>
      <a href="/canopy">The HalfCut Canopy</a>
      <a href="/yalada-tours">Yalada Tours</a>
      <a href="/take-action">All ways to help</a>
      <a href="/contact">Partner With Us</a>
    </nav>
    <nav class="footer-col" aria-label="Explore">
      <h4>Proof &amp; Backlog</h4>
      <a href="/impact">Impact</a>
      <a href="/campaigns">Campaigns</a>
      <a href="/team">Team &amp; Board</a>
      <a href="/partners">Partners</a>
      <a href="/fieldnotes">Field Notes</a>
      <a href="/annual-reports">Annual Reports</a>
    </nav>
    <div class="footer-col">
      <h4>Registered Charity</h4>
      <p>HalfCut Limited</p>
      <p>ABN 24 642 788 814</p>
      <p>Registered with the ACNC</p>
      <a href="https://www.acnc.gov.au/charity" target="_blank" rel="noopener">ACNC register ↗</a>
    </div>
  </div>

  <div class="footer-sponsors">
    <h4>In partnership with</h4>
    <ul>
      {sponsors.map((s) => (
        <li>
          <img
            src={`/sponsors/${s.slug}.webp`}
            alt={s.name}
            loading="lazy"
            width="200" height="60"
          />
        </li>
      ))}
    </ul>
  </div>

  <div class="footer-bottom">
    <div>© 2026 HalfCut Limited</div>
    <div class="carbon-badge" id="carbonBadge">
      <span>Hosted on renewable energy</span>
      <span aria-hidden="true">·</span>
      <span id="pageWeight">measuring…</span>
    </div>
  </div>

  <div class="footer-wordmark" aria-hidden="true">
    <img src="/logo/halfcut-wordmark-cream.webp" alt="" />
  </div>
</footer>

<style is:global>
  .site-footer {
    position: relative;
    background: var(--ink);
    color: var(--cream);
    padding: var(--s-9) var(--pad-x, 32px) var(--s-6);
    isolation: isolate;
  }
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/assets-legacy/topo-pattern-hq.png');
    background-size: 1200px auto;
    background-repeat: repeat;
    opacity: .08;
    mix-blend-mode: screen;
    pointer-events: none;
    z-index: 0;
  }
  .site-footer > * { position: relative; z-index: 1; }
  .footer-aoc {
    max-width: 720px;
    margin-bottom: var(--s-9);
    padding-bottom: var(--s-7);
    font-family: var(--f-serif);
    font-weight: 300;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.55;
    opacity: .85;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-7);
    margin-bottom: var(--s-9);
  }
  .footer-col { display: flex; flex-direction: column; gap: 8px; }
  .footer-col h4 {
    font-family: var(--f-sans);
    font-size: 11px;
    letter-spacing: .18em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--acid);
    margin-bottom: 8px;
  }
  .footer-col a, .footer-col p {
    font-family: var(--f-serif);
    font-weight: 300;
    font-size: 16px;
    color: var(--cream);
    text-decoration: none;
    opacity: .8;
  }
  .footer-col a:hover { color: var(--acid); opacity: 1; }
  /* Sponsor strip — mono cream logos, one row, wraps on narrow.
     Logos are already trimmed + cream-tinted at 320px height. */
  .footer-sponsors {
    padding: var(--s-7) 0;
    margin-bottom: var(--s-6);
  }
  .footer-sponsors h4 {
    font-family: var(--f-sans);
    font-size: 11px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--acid);
    margin-bottom: var(--s-5);
  }
  .footer-sponsors ul {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap;
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
    row-gap: var(--s-5);
  }
  .footer-sponsors li { display: block; }
  .footer-sponsors img {
    display: block;
    height: 36px;
    width: auto;
    max-width: 200px;
    object-fit: contain;
    opacity: .75;
    transition: opacity .2s ease;
  }
  .footer-sponsors img:hover { opacity: 1; }
  .footer-bottom {
    display: flex; justify-content: space-between;
    align-items: center;
    padding-top: var(--s-5);
    font-family: var(--f-sans);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    opacity: .6;
  }
  .carbon-badge {
    display: inline-flex; gap: 10px; align-items: center;
  }

  /* Full-bleed HALFCUT wordmark image, stretched to the container edge. */
  .footer-wordmark {
    margin-top: var(--s-8);
    line-height: 0;
    user-select: none;
    pointer-events: none;
  }
  .footer-wordmark img {
    display: block;
    width: 100%;
    height: auto;
    opacity: .18;
  }

  @media (max-width: 720px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-bottom { flex-direction: column; gap: 8px; align-items: flex-start; }
  }
</style>

<script>
  // Tiny client-side script: measure transferred bytes of the loaded page
  // via the Performance API, display in the carbon badge. Honest, real-time.
  function reportWeight() {
    const el = document.getElementById('pageWeight');
    if (!el) return;
    try {
      const entries = performance.getEntriesByType('resource') as PerformanceResourceTiming[];
      const nav = (performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming) || null;
      let bytes = nav?.transferSize ?? 0;
      for (const r of entries) bytes += (r as any).transferSize ?? 0;
      const kb = Math.round(bytes / 1024);
      // Sustainable Web Design model: ~0.5g CO2 per MB on grid energy
      const grams = (bytes / 1024 / 1024) * 0.5;
      el.textContent = `${kb}KB · ${grams.toFixed(2)}g CO₂`;
    } catch {
      el.textContent = '';
    }
  }
  window.addEventListener('load', () => setTimeout(reportWeight, 100));
</script>
