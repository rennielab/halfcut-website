---
/**
 * Slide-out menu — opens from nav. Pure HTML/CSS shell, hydrated client-side
 * via a tiny script in BaseLayout.
 */
// Trimmed primary menu — Ben's call: keep 6 top-level, push everything else
// (proof, transparency, backlog) to the footer.
const NAV_LINKS = [
  { href: '/',              label: 'Home' },
  { href: '/about',         label: 'About' },
  { href: '/heal-country',  label: 'Heal Country' },
  { href: '/go-halfcut',    label: 'Go HalfCut' },
  { href: '/yalada-tours',  label: 'Yalada Tours' },
  { href: '/canopy',        label: 'The Canopy' },
];
---

<div class="slideout" id="slideout" aria-hidden="true">
  <div class="slideout-scrim" data-close></div>
  <aside class="slideout-panel" aria-label="Site navigation" role="dialog" aria-modal="true">
    <header class="slideout-head">
      <span class="slideout-label">Menu</span>
      <button class="slideout-close" data-close aria-label="Close">
        Close <span aria-hidden="true">✕</span>
      </button>
    </header>
    <nav class="menu-list" aria-label="Primary">
      {NAV_LINKS.map((l) => (
        <a href={l.href} class="menu-link">{l.label}</a>
      ))}
    </nav>
    <div class="menu-ctas">
      <a href="/take-action" class="menu-cta menu-cta-cream">Take Action</a>
      <a href="/donate" class="menu-cta menu-cta-primary">Donate</a>
      <a href="/contact" class="menu-cta menu-cta-ghost">Contact</a>
    </div>
    <footer class="slideout-foot">
      <div>© 2026 HalfCut Limited</div>
      <div>Gadigal &amp; Kuku Yalanji Country</div>
    </footer>
  </aside>
</div>

<style is:global>
  .slideout {
    position: fixed; inset: 0; z-index: 100;
    pointer-events: none;
    opacity: 0;
    transition: opacity .25s var(--ease, ease);
  }
  .slideout[aria-hidden="false"] { opacity: 1; pointer-events: auto; }
  .slideout-scrim {
    position: absolute; inset: 0;
    background: rgba(19,20,14,.5);
    backdrop-filter: blur(4px);
  }
  .slideout-panel {
    position: absolute; top: 0; right: 0; bottom: 0;
    width: min(560px, 92vw);
    background: var(--cream);
    color: var(--ink);
    padding: 24px 32px;
    display: flex; flex-direction: column;
    transform: translateX(100%);
    transition: transform .35s var(--ease, ease);
    overflow-y: auto;
  }
  .slideout[aria-hidden="false"] .slideout-panel { transform: translateX(0); }
  .slideout-head {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: var(--s-5);
    border-bottom: 1px solid var(--ink-15);
  }
  .slideout-label, .slideout-close {
    font-family: var(--f-sans); font-size: 11px;
    letter-spacing: .18em; text-transform: uppercase;
    font-weight: 700;
  }
  .slideout-close {
    background: transparent; border: 0; cursor: pointer;
    color: var(--ink);
    display: inline-flex; gap: 8px; align-items: center;
  }
  .menu-list {
    flex-grow: 1;
    display: flex; flex-direction: column; gap: 2px;
    padding: var(--s-7) 0;
  }
  .menu-link {
    font-family: var(--f-display);
    font-size: clamp(28px, 3.3vw, 50px);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding: 8px 0;
  }
  .menu-link:hover { color: var(--coral); }
  .menu-ctas {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
    padding-top: var(--s-5);
    border-top: 1px solid var(--ink-15);
  }
  .menu-cta {
    text-align: center;
    text-decoration: none;
    padding: 14px 12px;
    border-radius: 6px;
    font-family: var(--f-sans);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .menu-cta-primary { background: var(--ink); color: var(--cream); }
  .menu-cta-cream { background: var(--acid); color: var(--ink); }
  .menu-cta-ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink-15); }
  .slideout-foot {
    margin-top: var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--ink-15);
    display: flex; justify-content: space-between;
    font-family: var(--f-sans); font-size: 11px;
    letter-spacing: .14em; text-transform: uppercase;
    opacity: .55;
  }
</style>

<script>
  // Open / close handlers for the slide-out
  function init() {
    const slideout = document.getElementById('slideout');
    if (!slideout) return;
    document.querySelectorAll('[data-open-menu]').forEach((btn) => {
      btn.addEventListener('click', () => {
        slideout.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });
    });
    slideout.querySelectorAll('[data-close]').forEach((el) => {
      el.addEventListener('click', () => {
        slideout.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && slideout.getAttribute('aria-hidden') === 'false') {
        slideout.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
</script>
